{
  "name": "LOOP Weather Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "name": "Schedule - Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/tracking/active",
        "method": "GET",
        "options": {}
      },
      "name": "Get Active Couriers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {}
      },
      "name": "Split Couriers",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/weather/impact",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\"latitude\": {{$json.latitude}}, \"longitude\": {{$json.longitude}}}"
      },
      "name": "Check Weather Impact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [910, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.impact_score}}",
              "operation": "smaller",
              "value2": 0.5
            }
          ]
        }
      },
      "name": "Dangerous Weather",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "functionCode": "const courier = $input.first().json;\n\nreturn {\n  json: {\n    courier_id: courier.courier_id,\n    courier_name: courier.courier_name,\n    weather: courier.weather_conditions.description,\n    recommendation: courier.recommendation,\n    alert: `WEATHER ALERT: ${courier.recommendation}. Current: ${courier.weather_conditions.description}`\n  }\n};"
      },
      "name": "Prepare Alert",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "text": "LOOP Weather Alert\n\nCourier: {{$json.courier_name}}\nCondition: {{$json.weather}}\n{{$json.alert}}\n\nPlease proceed with caution!"
      },
      "name": "Send SMS Alert",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1570, 200]
    }
  ],
  "connections": {
    "Schedule - Every 30 min": {
      "main": [[{"node": "Get Active Couriers", "type": "main", "index": 0}]]
    },
    "Get Active Couriers": {
      "main": [[{"node": "Split Couriers", "type": "main", "index": 0}]]
    },
    "Split Couriers": {
      "main": [[{"node": "Check Weather Impact", "type": "main", "index": 0}]]
    },
    "Check Weather Impact": {
      "main": [[{"node": "Dangerous Weather", "type": "main", "index": 0}]]
    },
    "Dangerous Weather": {
      "main": [
        [{"node": "Prepare Alert", "type": "main", "index": 0}],
        [{"node": "Split Couriers", "type": "main", "index": 0}]
      ]
    },
    "Prepare Alert": {
      "main": [[{"node": "Send SMS Alert", "type": "main", "index": 0}]]
    },
    "Send SMS Alert": {
      "main": [[{"node": "Split Couriers", "type": "main", "index": 0}]]
    }
  }
}
