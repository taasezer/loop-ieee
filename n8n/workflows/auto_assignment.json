{
  "name": "LOOP Auto-Assignment Enhanced",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - New Order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "webhook-new-order"
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/ai/recommend",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LOOP_API_TOKEN}}"
            }
          ]
        },
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 1000
          }
        },
        "bodyParametersJson": "={\"order_id\": \"{{$json.order_id}}\"}"
      },
      "name": "Get AI Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300],
      "id": "get-ai-recommendation",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "functionCode": "// Log the API request\nconst timestamp = new Date().toISOString();\nconst orderId = $input.first().json.order_id;\n\nconsole.log(`[${timestamp}] AI Recommendation requested for Order #${orderId}`);\n\nreturn {\n  json: {\n    timestamp,\n    order_id: orderId,\n    event: 'ai_recommendation_requested'\n  }\n};"
      },
      "name": "Log Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 150],
      "id": "log-request"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.recommended_courier}}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "exists"
              }
            },
            {
              "leftValue": "={{$json.recommended_courier.total_score}}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combineOperation": "all"
        }
      },
      "name": "Check Score",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300],
      "id": "check-score"
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/ai/assign",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LOOP_API_TOKEN}}"
            }
          ]
        },
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 1000
          }
        },
        "bodyParametersJson": "={\"order_id\": \"{{$json.order_id}}\"}"
      },
      "name": "Auto Assign Courier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [910, 200],
      "id": "auto-assign-courier",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json;\nconst timestamp = new Date().toISOString();\n\n// Log successful assignment\nconsole.log(`[${timestamp}] Order #${data.order_id} assigned to ${data.assigned_courier.courier_name}`);\n\nreturn {\n  json: {\n    courier_name: data.assigned_courier.courier_name,\n    courier_phone: data.assigned_courier.phone || 'N/A',\n    order_id: data.order_id,\n    estimated_time: data.assigned_courier.estimated_time_minutes,\n    distance: data.assigned_courier.distance_km,\n    total_score: data.assigned_courier.total_score,\n    timestamp\n  }\n};"
      },
      "name": "Prepare Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1130, 200],
      "id": "prepare-notification"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.LOOP_API_URL}}/api/notifications",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.LOOP_API_TOKEN}}"
            }
          ]
        },
        "jsonParameters": true,
        "bodyParametersJson": "={\"type\": \"order_assigned\", \"title\": \"🚀 New Delivery Assigned!\", \"message\": \"Courier: {{$json.courier_name}}\\nOrder: #{{$json.order_id}}\\nDistance: {{$json.distance}} km\\nETA: {{$json.estimated_time}} min\\nScore: {{$json.total_score}}\", \"order_id\": {{$json.order_id}}}"
      },
      "name": "Send Push Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1350, 200],
      "id": "send-notification",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"message\": \"Order assigned successfully\", \"courier\": \"{{$json.courier_name}}\", \"order_id\": {{$json.order_id}}, \"eta_minutes\": {{$json.estimated_time}}}"
      },
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1570, 200],
      "id": "respond-success"
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json;\nconst timestamp = new Date().toISOString();\nconst score = data.recommended_courier?.total_score || 0;\n\nconsole.log(`[${timestamp}] Order #${data.order_id} requires manual assignment (score: ${score})`);\n\nreturn {\n  json: {\n    order_id: data.order_id,\n    score: score,\n    reason: 'Score too low for auto-assignment',\n    timestamp\n  }\n};"
      },
      "name": "Log Manual Assignment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 400],
      "id": "log-manual"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"message\": \"Score too low, manual assignment needed\", \"order_id\": {{$json.order_id}}, \"score\": {{$json.score}}, \"requires_manual_review\": true}"
      },
      "name": "Respond Manual",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1130, 400],
      "id": "respond-manual"
    },
    {
      "parameters": {
        "functionCode": "const error = $input.first().json;\nconst timestamp = new Date().toISOString();\n\nconsole.error(`[${timestamp}] API Error:`, error);\n\nreturn {\n  json: {\n    error: true,\n    message: error.message || 'API request failed',\n    timestamp\n  }\n};"
      },
      "name": "Handle Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 500],
      "id": "handle-error"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"error\": \"Internal server error\", \"message\": \"{{$json.message}}\", \"retry\": true}",
        "responseCode": 500
      },
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [910, 500],
      "id": "respond-error"
    }
  ],
  "connections": {
    "Webhook - New Order": {
      "main": [
        [
          {"node": "Get AI Recommendation", "type": "main", "index": 0},
          {"node": "Log Request", "type": "main", "index": 0}
        ]
      ]
    },
    "Get AI Recommendation": {
      "main": [[{"node": "Check Score", "type": "main", "index": 0}]],
      "error": [[{"node": "Handle Error", "type": "main", "index": 0}]]
    },
    "Check Score": {
      "main": [
        [{"node": "Auto Assign Courier", "type": "main", "index": 0}],
        [{"node": "Log Manual Assignment", "type": "main", "index": 0}]
      ]
    },
    "Auto Assign Courier": {
      "main": [[{"node": "Prepare Notification", "type": "main", "index": 0}]],
      "error": [[{"node": "Handle Error", "type": "main", "index": 0}]]
    },
    "Prepare Notification": {
      "main": [[{"node": "Send Push Notification", "type": "main", "index": 0}]]
    },
    "Send Push Notification": {
      "main": [[{"node": "Respond Success", "type": "main", "index": 0}]]
    },
    "Log Manual Assignment": {
      "main": [[{"node": "Respond Manual", "type": "main", "index": 0}]]
    },
    "Handle Error": {
      "main": [[{"node": "Respond Error", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
