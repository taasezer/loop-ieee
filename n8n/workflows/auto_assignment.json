{
  "name": "LOOP Auto-Assignment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - New Order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/ai/recommend",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\"order_id\": \"{{$json.order_id}}\"}"
      },
      "name": "Get AI Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.recommended_courier.total_score}}",
              "operation": "larger",
              "value2": 0.7
            }
          ]
        }
      },
      "name": "Check Score",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "url": "={{$env.LOOP_API_URL}}/api/ai/assign",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\"order_id\": \"{{$json.order_id}}\"}"
      },
      "name": "Auto Assign Courier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [910, 200]
    },
    {
      "parameters": {
        "functionCode": "const data = $input.first().json;\n\nreturn {\n  json: {\n    courier_name: data.assigned_courier.courier_name,\n    order_id: data.order_id,\n    estimated_time: data.assigned_courier.estimated_time_minutes,\n    distance: data.assigned_courier.distance_km\n  }\n};"
      },
      "name": "Prepare Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "text": "New delivery assigned!\nCourier: {{$json.courier_name}}\nOrder: {{$json.order_id}}\nDistance: {{$json.distance}} km\nETA: {{$json.estimated_time}} min"
      },
      "name": "Send Notification",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"message\": \"Order assigned successfully\"}"
      },
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1570, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": false, \"message\": \"Score too low, manual assignment needed\"}"
      },
      "name": "Respond Manual",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [910, 400]
    }
  ],
  "connections": {
    "Webhook - New Order": {
      "main": [[{"node": "Get AI Recommendation", "type": "main", "index": 0}]]
    },
    "Get AI Recommendation": {
      "main": [[{"node": "Check Score", "type": "main", "index": 0}]]
    },
    "Check Score": {
      "main": [
        [{"node": "Auto Assign Courier", "type": "main", "index": 0}],
        [{"node": "Respond Manual", "type": "main", "index": 0}]
      ]
    },
    "Auto Assign Courier": {
      "main": [[{"node": "Prepare Notification", "type": "main", "index": 0}]]
    },
    "Prepare Notification": {
      "main": [[{"node": "Send Notification", "type": "main", "index": 0}]]
    },
    "Send Notification": {
      "main": [[{"node": "Respond Success", "type": "main", "index": 0}]]
    }
  }
}
