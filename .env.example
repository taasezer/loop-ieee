# LOOP Lojistik Platformu - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi konfigürasyonunuza göre düzenleyin

# =============================================================================
# UYGULAMA AYARLARI
# =============================================================================
APP_NAME="LOOP Lojistik Platformu"
APP_VERSION="1.0.0"
DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# GÜVENLİK AYARLARI
# =============================================================================
# Üretim ortamında mutlaka değiştirin!
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 gün

# =============================================================================
# VERİTABANI AYARLARI
# =============================================================================
# Yerel geliştirme için
DATABASE_URL=postgresql+asyncpg://loop_user:loop_password@localhost:5432/loop_db

# Üretim ortamı için (Docker)
# DATABASE_URL=postgresql+asyncpg://loop_user:loop_password@db:5432/loop_db

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# =============================================================================
# REDIS AYARLARI
# =============================================================================
# Yerel geliştirme için
REDIS_URL=redis://localhost:6379

# Üretim ortamı için (Docker)
# REDIS_URL=redis://redis:6379

REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# API ANAHTARLARI
# =============================================================================
# Mapbox API (Zorunlu - Harita ve rota planlama için)
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token-here

# OpenWeatherMap API (Opsiyonel - Hava durumu için)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Currency API (Opsiyonel - Döviz kurları için)
CURRENCY_API_KEY=your-currency-api-key-here

# n8n Webhook URL (Opsiyonel - AI otomasyonları için)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loop-ai-decisions

# =============================================================================
# HARİTA VE GPS AYARLARI
# =============================================================================
DEFAULT_MAP_CENTER_LAT=41.0082      # İstanbul merkez
DEFAULT_MAP_CENTER_LNG=28.9784
DEFAULT_MAP_ZOOM=12
MAX_ROUTE_DISTANCE_KM=100

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# CACHE AYARLARI
# =============================================================================
CACHE_TTL_SECONDS=300           # 5 dakika
WEATHER_CACHE_TTL=1800          # 30 dakika
CURRENCY_CACHE_TTL=3600         # 1 saat

# =============================================================================
# KURYE VE TESLİMAT AYARLARI
# =============================================================================
MAX_COURIER_ASSIGNMENT_DISTANCE_KM=10
DEFAULT_DELIVERY_TIME_MINUTES=45
PRIORITY_DELIVERY_TIME_MINUTES=25

# =============================================================================
# CORS AYARLARI
# =============================================================================
# Frontend URL'leri (virgülle ayrılmış)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://loop.com,https://app.loop.com

# =============================================================================
# NOTIFICATION AYARLARI
# =============================================================================
# SMS Servisi (Opsiyonel)
SMS_API_KEY=

# Email Servisi (Opsiyonel)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# =============================================================================
# MONITORING AYARLARI
# =============================================================================
# Grafana admin şifresi
GRAFANA_PASSWORD=admin

# =============================================================================
# GELİŞTİRME AYARLARI
# =============================================================================
# Test modu için
TESTING=False

# CI/CD ortamı için
CI=False

# =============================================================================
# n8n AYARLARI
# =============================================================================
N8N_USER=admin
N8N_PASSWORD=password
N8N_HOST=localhost