# Application Settings
APP_NAME=LOOP
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
API_V1_PREFIX=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=True

# Database Configuration
DATABASE_URL=postgresql+asyncpg://loop_user:loop_password@localhost:5432/loop_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# OpenStreetMap / Nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LOOP-Logistics-App

# OSRM (Self-hosted or public)
OSRM_URL=http://router.project-osrm.org

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here
MAPBOX_API_URL=https://api.mapbox.com

# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Currency Exchange API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@loop-logistics.com
SENDGRID_FROM_NAME=LOOP Logistics

# Stripe Payment
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# İyzico Payment (Turkey)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# n8n Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# AI/ML Settings
ML_MODEL_PATH=./app/ai/models
COURIER_ASSIGNMENT_MODEL=courier_assignment_v1.pkl
ROUTE_OPTIMIZATION_ENABLED=True

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=10000

# Geofencing
DEFAULT_GEOFENCE_RADIUS_KM=50

# Pricing Configuration
BASE_PRICE=10.0
PRICE_PER_KM=2.5
SURGE_MULTIPLIER_MAX=3.0
WEATHER_PRICE_MULTIPLIER=1.2

# Notification Settings
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_BATCH_SIZE=100

# Session Configuration
SESSION_EXPIRE_SECONDS=3600

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# Admin Configuration
ADMIN_EMAIL=admin@loop-logistics.com
ADMIN_PASSWORD=change-this-password

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
