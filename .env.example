# ==========================================
# 1. DATABASE & CACHE
# ==========================================
# SQLAlchemy Asyncpg connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loop_logistics
# Redis server address
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 2. SECURITY & JWT
# ==========================================
# Generate a strong secret key (e.g., openssl rand -hex 32)
SECRET_KEY=dev_secret_key_change_in_prod_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# 3. EXTERNAL API KEYS
# ==========================================
# Google Maps API Key for distance/duration calculation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# OpenWeather API Key for weather alerts
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Exchange Rate API Key (if applicable)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ==========================================
# 4. AUTOMATION (n8n)
# ==========================================
# Loop API token used by n8n to authenticate
LOOP_API_TOKEN=your_secure_api_token
# Loop API URL used by n8n
LOOP_API_URL=http://localhost:8000
# n8n webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# ==========================================
# 5. SERVER SETTINGS
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=*,http://localhost:3000,https://loop-app.com

# ==========================================
# 6. NOTIFICATION SERVICES
# ==========================================
# Twilio Configuration for SMS
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Configuration for Email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@loop-logistics.com

# FCM (Firebase Cloud Messaging) path to service account credentials JSON
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
